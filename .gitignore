.env
.venv/
__pycache__/
*.pyc

# 本地需求文档（不纳入版本管理）
对RAG的初步要求.docx
~$AG的初步要求.docx
# 由需求文档转换出的评测语料
data/rag_requirements.txt

# 运行时生成的会话记忆
memorys/chat_history/

# 运行时 / 派生数据（可重建）
chroma_db/
storage/
logs/
md5.text

# 本地评测集与单次评测快照（baseline.json 保留）
eval/golden_set.local.jsonl
eval/results/eval-*.json

# 语料 PDF：体积大且部分为在版出版物的扫描件，不入版本库
# 已跟踪的 `data/论语.pdf`、`data/测试pdf2.pdf` 不受此规则影响
data/*.pdf
